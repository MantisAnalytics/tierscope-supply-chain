# Copy to .env and fill in. Real environment variables take precedence over .env.

# Model: meta (default, Muse Spark through the Meta Model API) or glimmer (self-hosted Muse Glimmer)
SCGRAPH_LLM_PROVIDER=meta

# Meta Model API (api.meta.ai)
MODEL_API_KEY=

# Self-hosted Muse Glimmer, open weights (SCGRAPH_LLM_PROVIDER=glimmer): your vLLM server
MUSE_BASE_URL=http://localhost:8000/v1
MUSE_API_KEY=

# record (default), replay or off
SCGRAPH_LLM_CACHE=record

# Cumulative spend caps per provider, in USD
SCGRAPH_BUDGET_META_USD=5
SCGRAPH_BUDGET_GLIMMER_USD=5

# Graph database (SQLite)
SCGRAPH_GRAPH_DB=.cache/graph.sqlite

# Review: facts at or above this confidence apply without review (0..1)
SCGRAPH_REVIEW_THRESHOLD=0.9

# Author of edits and review decisions (default: the OS user)
SCGRAPH_AUTHOR=user

# Uploaded evidence files
SCGRAPH_EVIDENCE_DIR=.cache/evidence

# Operations and agent database, background jobs
SCGRAPH_OPS_DB=.cache/ops.sqlite
SCGRAPH_JOBS_DB=.cache/jobs.sqlite

# Agent: disruption events start the planner (on or off)
SCGRAPH_AGENT_TRIGGERS=on
# Cumulative spend cap for event-started agent turns, in USD
SCGRAPH_BUDGET_AUTO_USD=2
# Spending limit per disruption shown on a plan, in EUR; every plan still waits for a person to accept it
SCGRAPH_AGENT_SPEND_LIMIT_EUR=250000
